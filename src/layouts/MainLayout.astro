---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const headerData = {
  title: 'My Site',
  description: 'Welcome!',
  logo: { url: '/favicon.svg', alt: 'Logo' },
  fontFamily: 'Arial',
  backgroundColor: 'darkblue',
  textColor: 'white',
};

const footerData = {
  footerText: '© Clint Kingston 2026',
  fontFamily: 'Arial',
  backgroundColor: 'darkblue',
  textColor: 'white',
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />
    <link
      rel="icon"
      href="/favicon.ico"
    />
    <link
      href="default.css"
      rel="stylesheet"
      title="Default Style"
    />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <meta
      name="generator"
      content={Astro.generator}
    />

    <ClientRouter />

    <title>Astro</title>
  </head>
  <body>
    <Header
      title={headerData.title}
      description={headerData.description}
      logo={headerData.logo}
      fontFamily={headerData.fontFamily}
      backgroundColor={headerData.backgroundColor}
      textColor={headerData.textColor}
    />
    <div class="slot">
      <slot />
    </div>
    <Footer
      footerText={footerData.footerText}
      fontFamily={footerData.fontFamily}
      backgroundColor={footerData.backgroundColor}
      textColor={footerData.textColor}
    />
  </body><style>
    body {
      display: flex;
      flex-direction: column;
    }

    .slot {
      padding: 12px;
    }
  </style>
</html>

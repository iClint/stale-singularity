---
import Navigation from './Navigation.astro';
import CTAButton from './CTAButton.astro';

interface Props {
  title: string;
  description: string;
  logo: Logo;
  fontFamily: string;
  backgroundColor: string;
  textColor: string;
}
interface Logo {
  url: string;
  alt: string;
}
const { title, description, logo, fontFamily, backgroundColor, textColor } =
  Astro.props;
---

<div
  class="header-wrapper"
  style={`--fontFamily:${fontFamily};--bg:${backgroundColor}; --text: ${textColor}`}>
  <header class="header-container">
    <div class="brand">
      <img
        class="logo"
        src={logo.url}
        alt={logo.alt}
      />
      <div class="title-tagline">
        <h1 class="title">{title}</h1>
        <p class="tagline">{description}</p>
      </div>
    </div>
    <div class="header-cta">
      <CTAButton href="/contact" text="Book Now" />
    </div>
  </header>
  <Navigation />
</div>

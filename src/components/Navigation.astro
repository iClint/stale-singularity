---
const currentPath = Astro.url.pathname;
const pages = [
  { label: 'Home', url: '/' },
  { label: 'Services', url: '/services' },
  { label: 'About', url: '/about' },
  { label: 'Contact', url: '/contact' },
];
---

<nav class="nav-wrapper">
  <div class="nav-container">
    {
      pages.map((page) => (
        <a
          href={page.url}
          class:list={['nav-link', { active: currentPath === page.url }]}>
          {page.label}
          {currentPath === page.url && <span class="indicator" />}
        </a>
      ))
    }
  </div>
</nav>

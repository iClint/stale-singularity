---
import { IndexConfig } from './index-config';
import type { Person, Dob } from '../models/person.model';
import MainLayout from '../layouts/MainLayout.astro';

const hw = 'Hello World!';
const people = IndexConfig;

function calculateAge(dob: Dob): number {
  const today = new Date();
  const age = today.getFullYear() - dob.year;

  // Returns age - 1 if the birthday hasn't happened yet
  return today.getMonth() + 1 < dob.month ||
    (today.getMonth() + 1 === dob.month && today.getDate() < dob.day)
    ? age - 1
    : age;
}
---

<MainLayout
  ><h1>Astro</h1>
  <p>{hw}</p>
</MainLayout>


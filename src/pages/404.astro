---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout>
  <div class="error-hero">
    <div class="error-content">
      <h1>404</h1>
      <h2>Page Not Found</h2>
      <p>The page you're looking for doesn't exist or has been moved.</p>
      <div class="error-actions">
        <a href="/" class="cta-button">Return Home</a>
        <a href="/contact" class="cta-button-outline">Contact Us</a>
      </div>
    </div>
  </div>
</MainLayout>

<style>
  .error-hero {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #b8d84e, #5a8f3a);
    padding: 4rem 2rem;
  }

  .error-content {
    text-align: center;
    color: #ffffff;
    max-width: 600px;
  }

  .error-content h1 {
    font-size: 8rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.5rem;
    line-height: 1;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
  }

  .error-content h2 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .error-content p {
    font-size: 1.2rem;
    margin-bottom: 2rem;
    opacity: 0.9;
  }

  .error-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-button {
    display: inline-block;
    padding: 1rem 2.5rem;
    background: #ffffff;
    color: #5a8f3a;
    text-decoration: none;
    font-weight: 700;
    font-size: 1.1rem;
    border-radius: 50px;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    border: 3px solid #ffffff;
  }

  .cta-button:hover {
    transform: translateY(-2px);
    background: #5a8f3a;
    color: #ffffff;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
  }

  .cta-button-outline {
    display: inline-block;
    padding: 1rem 2.5rem;
    background: transparent;
    color: #ffffff;
    text-decoration: none;
    font-weight: 600;
    font-size: 1.1rem;
    border-radius: 50px;
    border: 3px solid #ffffff;
    transition: all 0.3s ease;
  }

  .cta-button-outline:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .error-content h1 {
      font-size: 5rem;
    }

    .error-content h2 {
      font-size: 2rem;
    }

    .error-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
